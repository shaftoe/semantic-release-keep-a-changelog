{
	"name": "@alexanderfortin/semantic-release-keep-a-changelog",
	"author": "Alexander Fortin",
	"version": "0.4.14",
	"description": "Opinionated semantic-release plugin that generates Keep a Changelog formatted CHANGELOG.md from conventional commits",
	"type": "module",
	"main": "./dist/index.js",
	"exports": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"package.json",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"build": "pnpm run validate && rm -rf dist && tsc --project tsconfig.build.json",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --project tsconfig.check.json",
		"check": "biome check",
		"format": "biome check --write",
		"prepublishOnly": "tsc --project tsconfig.build.json",
		"validate": "pnpm run typecheck && pnpm run check",
		"release": "semantic-release",
		"release:dry-run": "semantic-release --dry-run"
	},
	"keywords": [
		"semantic-release",
		"changelog",
		"keep-a-changelog",
		"release-notes"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"pnpm": ">=12"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/shaftoe/semantic-release-keep-a-changelog"
	},
	"dependencies": {
		"@semantic-release/error": "^4.0.0",
		"conventional-changelog-writer": "^9.2.1",
		"conventional-commits-filter": "^6.0.1",
		"conventional-commits-parser": "^7.1.2",
		"get-stream": "9.0.1",
		"into-stream": "^9.1.0",
		"temporal-polyfill": "^1.0.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@semantic-release/commit-analyzer": "13.0.1",
		"@semantic-release/exec": "7.1.0",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.10",
		"@semantic-release/npm": "^13.2.0",
		"@types/node": "^26.6.2",
		"@vitest/coverage-v8": "^4.0.18",
		"markdownlint": "^0.41.1",
		"semantic-release": "^25.0.9",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^4.0.18"
	},
	"peerDependencies": {
		"semantic-release": ">=24.0.0"
	}
}
